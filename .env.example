# Application Settings
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-secure-random-key-in-production
PORT=5000
DEBUG=True

# Database Configuration
# Supported options: 'oracle' or 'sqlite'
# Defaults to 'sqlite' if Oracle credentials are not configured or Oracle is unreachable
DB_ENGINE=sqlite

# Oracle Database Free Configuration (when DB_ENGINE=oracle)
ORACLE_USER=healthcare_admin
ORACLE_PASSWORD=your_secure_password_here
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=FREEPDB1
ORACLE_CONNECT_TIMEOUT=10

# SQLite Configuration (used for local testing & development without Oracle)
SQLITE_DB_PATH=healthcare.db

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
